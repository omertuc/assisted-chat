+def _dump_gemini_traffic(direction: str, url: str, headers: dict, data: Any, response_text: str = "") -> None:
+    """Dump Gemini HTTP traffic to /tmp/litegemini.txt in JSON Lines format for machine readability."""
+    try:
+        import datetime
+        timestamp = datetime.datetime.now().isoformat()
+        
+        log_entry = {
+            "timestamp": timestamp,
+            "direction": direction,
+            "url": url,
+            "headers": dict(headers)
+        }
+        
+        if direction == "REQUEST":
+            if isinstance(data, str):
+                try:
+                    log_entry["request_body"] = json.loads(data)
+                except json.JSONDecodeError:
+                    log_entry["request_body"] = data
+            else:
+                log_entry["request_body"] = data
+        elif direction in ["RESPONSE", "STREAMING_RESPONSE"]:
+            if response_text:
+                try:
+                    log_entry["response_body"] = json.loads(response_text)
+                except json.JSONDecodeError:
+                    log_entry["response_body"] = response_text
+        
+        with open("/tmp/litegemini.txt", "a", encoding="utf-8") as f:
+            f.write(json.dumps(log_entry) + "\n")
+            
+    except Exception as e:
+        verbose_logger.warning(f"Failed to dump Gemini traffic: {e}")
+
